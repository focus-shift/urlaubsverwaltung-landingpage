<!doctype html>
<html lang="de">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>
		{{#if title}}{{title}} {{/if}}
	</title>
	<meta property="og:locale" content="de_DE" />
	<meta property="og:url" content="https://urlaubsverwaltung.cloud" />
	<meta property="og:site_name" content="Urlaubsverwaltung.cloud" />
	<meta property="og:title" content="{{#if title}}{{title}}{{/if}}" />
	<meta property="og:type" content="website" />
	<meta property="og:image" content="/static/uv-multidevice_sm.png" />
	{{#if description}}
		<meta property="og:description" content="{{description}}" />
		<meta name="description" content="{{description}}" />
	{{/if}}
	<meta name="theme-color" content="#9b9bff" media="(prefers-color-scheme: light)">
	<meta name="theme-color" content="#50287d" media="(prefers-color-scheme: dark)">
	<link rel="stylesheet" href="/static/css/style.css" />
	<link rel="stylesheet" href="/static/css/fonts.css" />
	{{#each stylesheets}}
	<link rel="stylesheet" href="{{this}}" />
	{{/each}}
	<script type="module" src="/static/js/common.js"></script>
	{{#each scripts}}
		<script type="module" src="{{this}}"></script>
	{{/each}}
</head>
<body class="flex flex-col">
  {{> partials/navigation active=navigation.activeItem}}
	<div class="flex-1 bg-white">
		{{{ content }}}
	</div>
  {{> partials/footer }}
</body>
</html>
