---
redirectBaseUrl: https://focus-shift.de
redirectDelaySeconds: 20
---
{#
	Every page of this site redirects to the same path on focus-shift.de.
	`redirect.to` is set by src/redirect.njk for legacy `redirect_from` aliases,
	so aliases point straight to their final page instead of chaining.
	The 404 page has no matching path at build time; it uses location.pathname at runtime.
#}
{%- set isNotFoundPage = page.url == "/404.html" -%}
{%- set targetPath = redirect.to if (redirect and redirect.to) else ("/" if isNotFoundPage else page.url) -%}
{%- set targetUrl = redirectBaseUrl + targetPath -%}
<!DOCTYPE html>
<html lang="de">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Wir sind umgezogen: focus-shift.de</title>
	{%- if not isNotFoundPage %}
	<link rel="canonical" href="{{ targetUrl }}" />
	{%- endif %}
	<noscript>
		<meta http-equiv="refresh" content="0; url={{ targetUrl }}" />
	</noscript>
</head>
<body>
	<main>
		<h1>Wir sind umgezogen</h1>
		<p>
			Diese Seite findest du ab sofort unter
			<a id="redirect-target" href="{{ targetUrl }}">{{ targetUrl }}</a>.
		</p>
		<p>
			Bitte aktualisiere deine Lesezeichen: Klicke auf den Button und setze auf
			der neuen Seite ein neues Lesezeichen.
		</p>
		<p>
			<a id="redirect-now" href="{{ targetUrl }}">Jetzt zu focus-shift.de</a>
		</p>
		<p aria-live="polite">
			<span id="redirect-status">Du wirst in <span id="redirect-countdown">{{ redirectDelaySeconds }}</span> Sekunden automatisch weitergeleitet.</span>
		</p>
		<p>
			<button type="button" id="redirect-stop">Weiterleitung stoppen</button>
		</p>
	</main>
	<script>
		(function () {
			var baseUrl = {{ redirectBaseUrl | dump | safe }};
			var path = {{ ("" if isNotFoundPage else targetPath) | dump | safe }} || location.pathname;
			var target = baseUrl + path + location.search + location.hash;

			document.querySelectorAll("#redirect-target, #redirect-now").forEach(function (link) {
				link.href = target;
			});
			document.getElementById("redirect-target").textContent = baseUrl + path;

			var remaining = {{ redirectDelaySeconds }};
			var countdown = document.getElementById("redirect-countdown");
			var timer = setInterval(function () {
				remaining -= 1;
				if (remaining <= 0) {
					clearInterval(timer);
					location.replace(target);
					return;
				}
				countdown.textContent = remaining;
			}, 1000);

			var stopButton = document.getElementById("redirect-stop");
			stopButton.addEventListener("click", function () {
				clearInterval(timer);
				document.getElementById("redirect-status").textContent = "Automatische Weiterleitung gestoppt.";
				stopButton.hidden = true;
			});
		})();
	</script>
</body>
</html>
